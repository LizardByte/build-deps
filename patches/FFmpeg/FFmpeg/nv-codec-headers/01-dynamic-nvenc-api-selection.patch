+    /* SDK 11.0 and 12.0 use an eight-byte-larger version of this ABI
+     * structure than SDK 13.0. Keep the private context layout identical
+     * across all version-isolated implementations. */
+    union {
+        NV_ENC_INITIALIZE_PARAMS init_encode_params;
+        uint64_t init_encode_params_storage[226];
