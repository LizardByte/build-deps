diff --git a/libavcodec/nvenc_dispatch.c b/libavcodec/nvenc_dispatch.c
new file mode 100644
index 0000000..d776e6a
--- /dev/null
+++ b/libavcodec/nvenc_dispatch.c
@@ -0,0 +1,221 @@
+/*
+ * Runtime dispatch for version-isolated NVENC implementations.
+ *
+ * NVIDIA preserves backward compatibility within the driver, but each SDK
+ * revision defines its own structure versions and, in some cases, different
+ * structure layouts.  Select an implementation compiled with headers that
+ * the installed driver supports instead of rewriting version fields in
+ * structures compiled from a newer SDK.
+ */
+
+#include "config.h"
+#include "config_components.h"
+
+#include "nvenc.h"
+
+#define NVENC_DRIVER_VERSION(major, minor) (((major) << 4) | (minor))
+
+int ff_nvenc_encode_init_1100(AVCodecContext *avctx);
+int ff_nvenc_encode_close_1100(AVCodecContext *avctx);
+int ff_nvenc_receive_packet_1100(AVCodecContext *avctx, AVPacket *pkt);
+void ff_nvenc_encode_flush_1100(AVCodecContext *avctx);
+int ff_nvenc_context_abi_matches_1100(const NvencContextABI *expected);
+
+int ff_nvenc_encode_init_1200(AVCodecContext *avctx);
+int ff_nvenc_encode_close_1200(AVCodecContext *avctx);
+int ff_nvenc_receive_packet_1200(AVCodecContext *avctx, AVPacket *pkt);
+void ff_nvenc_encode_flush_1200(AVCodecContext *avctx);
+int ff_nvenc_context_abi_matches_1200(const NvencContextABI *expected);
+
+int ff_nvenc_encode_init_1300(AVCodecContext *avctx);
+int ff_nvenc_encode_close_1300(AVCodecContext *avctx);
+int ff_nvenc_receive_packet_1300(AVCodecContext *avctx, AVPacket *pkt);
+void ff_nvenc_encode_flush_1300(AVCodecContext *avctx);
+int ff_nvenc_context_abi_matches_1300(const NvencContextABI *expected);
+
+int ff_nvenc_encode_init_1310(AVCodecContext *avctx);
+int ff_nvenc_encode_close_1310(AVCodecContext *avctx);
+int ff_nvenc_receive_packet_1310(AVCodecContext *avctx, AVPacket *pkt);
+void ff_nvenc_encode_flush_1310(AVCodecContext *avctx);
+
+static const char *nvenc_sdk_name(NvencSDKVersion sdk)
+{
+    switch (sdk) {
+    case NVENC_SDK_1100:
+        return "11.0";
+    case NVENC_SDK_1200:
+        return "12.0";
+    case NVENC_SDK_1300:
+        return "13.0";
+    case NVENC_SDK_1310:
+        return "13.1";
+    case NVENC_SDK_UNSUPPORTED:
+    default:
+        return "unsupported";
+    }
+}
+
+static int nvenc_sdk_context_abi_matches(NvencSDKVersion sdk)
+{
+    const NvencContextABI expected = nvenc_context_abi();
+
+    switch (sdk) {
+    case NVENC_SDK_1100:
+        return ff_nvenc_context_abi_matches_1100(&expected);
+    case NVENC_SDK_1200:
+        return ff_nvenc_context_abi_matches_1200(&expected);
+    case NVENC_SDK_1300:
+        return ff_nvenc_context_abi_matches_1300(&expected);
+    case NVENC_SDK_1310:
+        return 1;
+    case NVENC_SDK_UNSUPPORTED:
+    default:
+        return 0;
+    }
+}
+
+static av_cold int nvenc_select_sdk(AVCodecContext *avctx)
+{
+    NvencContext *ctx = avctx->priv_data;
+    NvencFunctions *nvenc_dl = NULL;
+    uint32_t max_version = 0;
+    NVENCSTATUS err;
+    int ret;
+
+    ret = nvenc_load_functions(&nvenc_dl, avctx);
+    if (ret < 0)
+        return ret;
+
+    err = nvenc_dl->NvEncodeAPIGetMaxSupportedVersion(&max_version);
+    nvenc_free_functions(&nvenc_dl);
+    if (err != NV_ENC_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR,
+               "Failed to query the maximum supported NVENC API version: %d\n",
+               err);
+        return AVERROR_EXTERNAL;
+    }
+
+    if (max_version >= NVENC_DRIVER_VERSION(13, 1))
+        ctx->selected_sdk = NVENC_SDK_1310;
+    else if (max_version >= NVENC_DRIVER_VERSION(13, 0))
+        ctx->selected_sdk = NVENC_SDK_1300;
+    else if (max_version >= NVENC_DRIVER_VERSION(12, 0))
+        ctx->selected_sdk = NVENC_SDK_1200;
+    else if (max_version >= NVENC_DRIVER_VERSION(11, 0))
+        ctx->selected_sdk = NVENC_SDK_1100;
+    else
+        ctx->selected_sdk = NVENC_SDK_UNSUPPORTED;
+
+    if (ctx->selected_sdk == NVENC_SDK_UNSUPPORTED) {
+        av_log(avctx, AV_LOG_ERROR,
+               "Driver does not support the minimum required NVENC API version. "
+               "Required: 11.0 Found: %u.%u\n",
+               max_version >> 4, max_version & 0xf);
+        return AVERROR(ENOSYS);
+    }
+
+    if (!nvenc_sdk_context_abi_matches(ctx->selected_sdk)) {
+        av_log(avctx, AV_LOG_ERROR,
+               "NVENC SDK %s private context ABI is incompatible with the "
+               "current headers\n",
+               nvenc_sdk_name(ctx->selected_sdk));
+        return AVERROR_BUG;
+    }
+
+    av_log(avctx, AV_LOG_VERBOSE,
+           "Driver supports NVENC API %u.%u; using SDK %s implementation\n",
+           max_version >> 4, max_version & 0xf,
+           nvenc_sdk_name(ctx->selected_sdk));
+    return 0;
+}
+
+av_cold int ff_nvenc_encode_init(AVCodecContext *avctx)
+{
+    NvencContext *ctx = avctx->priv_data;
+    int ret = nvenc_select_sdk(avctx);
+
+    if (ret < 0)
+        return ret;
+
+    if (ctx->selected_sdk == NVENC_SDK_1100 &&
+        avctx->codec_id == AV_CODEC_ID_AV1) {
+        av_log(avctx, AV_LOG_ERROR,
+               "AV1 encoding requires an NVENC 12.0 or newer driver API\n");
+        return AVERROR(ENOSYS);
+    }
+
+    switch (ctx->selected_sdk) {
+    case NVENC_SDK_1310:
+        return ff_nvenc_encode_init_1310(avctx);
+    case NVENC_SDK_1300:
+        return ff_nvenc_encode_init_1300(avctx);
+    case NVENC_SDK_1200:
+        return ff_nvenc_encode_init_1200(avctx);
+    case NVENC_SDK_1100:
+        return ff_nvenc_encode_init_1100(avctx);
+    case NVENC_SDK_UNSUPPORTED:
+    default:
+        return AVERROR(ENOSYS);
+    }
+}
+
+av_cold int ff_nvenc_encode_close(AVCodecContext *avctx)
+{
+    NvencContext *ctx = avctx->priv_data;
+
+    switch (ctx->selected_sdk) {
+    case NVENC_SDK_1310:
+        return ff_nvenc_encode_close_1310(avctx);
+    case NVENC_SDK_1300:
+        return ff_nvenc_encode_close_1300(avctx);
+    case NVENC_SDK_1200:
+        return ff_nvenc_encode_close_1200(avctx);
+    case NVENC_SDK_1100:
+        return ff_nvenc_encode_close_1100(avctx);
+    case NVENC_SDK_UNSUPPORTED:
+    default:
+        return 0;
+    }
+}
+
+int ff_nvenc_receive_packet(AVCodecContext *avctx, AVPacket *pkt)
+{
+    NvencContext *ctx = avctx->priv_data;
+
+    switch (ctx->selected_sdk) {
+    case NVENC_SDK_1310:
+        return ff_nvenc_receive_packet_1310(avctx, pkt);
+    case NVENC_SDK_1300:
+        return ff_nvenc_receive_packet_1300(avctx, pkt);
+    case NVENC_SDK_1200:
+        return ff_nvenc_receive_packet_1200(avctx, pkt);
+    case NVENC_SDK_1100:
+        return ff_nvenc_receive_packet_1100(avctx, pkt);
+    case NVENC_SDK_UNSUPPORTED:
+    default:
+        return AVERROR(EINVAL);
+    }
+}
+
+av_cold void ff_nvenc_encode_flush(AVCodecContext *avctx)
+{
+    NvencContext *ctx = avctx->priv_data;
+
+    switch (ctx->selected_sdk) {
+    case NVENC_SDK_1310:
+        ff_nvenc_encode_flush_1310(avctx);
+        break;
+    case NVENC_SDK_1300:
+        ff_nvenc_encode_flush_1300(avctx);
+        break;
+    case NVENC_SDK_1200:
+        ff_nvenc_encode_flush_1200(avctx);
+        break;
+    case NVENC_SDK_1100:
+        ff_nvenc_encode_flush_1100(avctx);
+        break;
+    case NVENC_SDK_UNSUPPORTED:
+    default:
+        break;
+    }
+}
