+typedef struct NvencContextABI {
+    size_t size;
+    size_t selected_sdk;
+    size_t nvenc_dload_funcs;
+    size_t init_encode_params;
+    size_t encode_config;
+    size_t cu_context;
+    size_t registered_frames;
+    size_t data_pix_fmt;
+    size_t nvencoder;
+    size_t preset;
+    size_t profile;
+    size_t display_sei_sent;
+} NvencContextABI;
+
+static inline NvencContextABI nvenc_context_abi(void)
+{
+    return (NvencContextABI) {
+        .size               = sizeof(NvencContext),
+        .selected_sdk       = offsetof(NvencContext, selected_sdk),
+        .nvenc_dload_funcs  = offsetof(NvencContext, nvenc_dload_funcs),
+        .init_encode_params = offsetof(NvencContext, init_encode_params),
+        .encode_config      = offsetof(NvencContext, encode_config),
+        .cu_context         = offsetof(NvencContext, cu_context),
+        .registered_frames  = offsetof(NvencContext, registered_frames),
+        .data_pix_fmt       = offsetof(NvencContext, data_pix_fmt),
+        .nvencoder          = offsetof(NvencContext, nvencoder),
+        .preset             = offsetof(NvencContext, preset),
+        .profile            = offsetof(NvencContext, profile),
+        .display_sei_sent   = offsetof(NvencContext, display_sei_sent),
+    };
+}
+
+static inline int nvenc_context_abi_matches(const NvencContextABI *expected)
+{
+    const NvencContextABI actual = nvenc_context_abi();
+
+    return actual.size               == expected->size &&
+           actual.selected_sdk       == expected->selected_sdk &&
+           actual.nvenc_dload_funcs  == expected->nvenc_dload_funcs &&
+           actual.init_encode_params == expected->init_encode_params &&
+           actual.encode_config      == expected->encode_config &&
+           actual.cu_context         == expected->cu_context &&
+           actual.registered_frames  == expected->registered_frames &&
+           actual.data_pix_fmt       == expected->data_pix_fmt &&
+           actual.nvencoder          == expected->nvencoder &&
+           actual.preset             == expected->preset &&
+           actual.profile            == expected->profile &&
+           actual.display_sei_sent   == expected->display_sei_sent;
+}
+
